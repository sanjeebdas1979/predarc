# Arc Mainnet PredarcDaily deployment. Never use the ForecastRegistry address.
NEXT_PUBLIC_PREDARC_DAILY_ADDRESS=
NEXT_PUBLIC_PREDARC_DAILY_ENABLED=false

# Base Mainnet must use a separate verified deployment.
NEXT_PUBLIC_PREDARC_BASE_DAILY_ADDRESS=
NEXT_PUBLIC_PREDARC_BASE_DAILY_ENABLED=false

# Base forecasting stays disabled until the same reviewed ForecastRegistryV2
# bytecode is deployed and verified on chain ID 8453.
NEXT_PUBLIC_PREDARC_BASE_FORECAST_REGISTRY_ADDRESS=

# Public attribution identifier from Base Dashboard > Project Settings >
# Builder Code. This is not a secret. Leave blank until the Predarc project has
# been registered; no fabricated or placeholder code is sent onchain.
NEXT_PUBLIC_BASE_BUILDER_CODE=
